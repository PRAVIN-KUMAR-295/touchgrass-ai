# ==============================================================================
# TouchGrass AI - Backend Environment Template
# Copy this file to .env and configure for local development.
# DO NOT commit real secrets or credentials to source control.
# ==============================================================================

# Server Configuration
PORT=8000
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=sqlite:///./touchgrass.db

# AI Configuration (OpenAI-compatible hosted Gemma endpoint)
# Supported Model: google/gemma-3-4b-it
AI_PROVIDER=gemma
HOSTED_API_BASE_URL=
HOSTED_API_KEY=
HOSTED_MODEL_NAME=google/gemma-3-4b-it
